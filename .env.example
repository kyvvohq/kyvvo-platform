# Copie pra .env (gitignored) pra rodar local. Em produção tudo vem do SSM
# via gen-env-from-ssm.sh (ver kyvvohq/kyvvo-infra / docs/ssm-cutover.md).

DATABASE_URL=postgres://platform_app:senha@localhost:5432/kyvvo
# DB_SEARCH_PATH=platform,public
# PGSSL=false

# Par RS256. Gerar: openssl genrsa -out priv.pem 2048 &&
# openssl rsa -in priv.pem -pubout -out pub.pem
# Aceita PEM cru (dev) ou `base64 -w0 priv.pem` (prod — env_file não faz
# valor multi-linha).
# PLATFORM_JWT_PRIVATE_KEY=
# PLATFORM_JWT_PUBLIC_KEY=
# PLATFORM_JWT_ISSUER=https://auth.kyvvo.com.br
# PLATFORM_JWT_ACCESS_TTL=3h

# Serviço de e-mail (lib/email.js). Sem provedor: modo log no console.
# EMAIL_PROVIDER=ses
# SES_REGION=us-east-1
# SES_CONFIGURATION_SET=kyvvo-default
# SES_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:<conta>:kyvvo-ses-eventos
# INTERNAL_EMAIL_TOKENS=studio:troque,people:troque,crm:troque,admin:troque
# EMAIL_FROM=Kyvvo <no-reply@kyvvo.com.br>
# RESEND_API_KEY=            (fallback da transição)
# RESEND_FROM=Kyvvo <no-reply@kyvvo.com.br>
# META_WHATSAPP_TOKEN=
# META_PHONE_NUMBER_ID=

PORT=3003
